# Example: run the control plane here and submit jobs to an Ascend host over ssh.
# Copy to local.env (gitignored) and replace the placeholders. Credentials belong
# in .env or the environment, never in this file.
FK_DELIVERY=ssh
FK_GPU=0
REMOTE_HOST=CHANGE_ME
REMOTE_WORKDIR=/srv/forgekernel-remote
REMOTE_ENV_FILE=/srv/forgekernel/repro/ascend/remote_env.sh

# Paths read on the Ascend host, not on the controller.
FK_ASCEND_PYTHON=python3
CANN_BENCH_DIR=/srv/cann-bench
# Optional: only set this when the installed PyPTO needs a PTO source tree.
# PTO_TILE_LIB_CODE_PATH=/srv/pto-isa

# Agent CLI on the controller.
FK_AGENT_PY=python3
FK_CLAUDE_BIN=claude
FORGEKERNEL_LOCK_DIR=/tmp/forgekernel-locks
