# Copy to local.env on the NEW agent host, then replace REMOTE_HOST.
# Secrets are exported from .env in the shell, not stored in this file.
FK_DELIVERY=ssh
FK_GPU=1
REMOTE_HOST=CHANGE_ME
REMOTE_WORKDIR=/mnt/home/dataset/shw/Workspace/forgekernel-remote
REMOTE_ENV_FILE=/mnt/home/dataset/shw/Workspace/ForgeKernel/repro/ascend/remote_env.sh

# These paths are read on the 950PR host, not on the agent host.
FK_ASCEND_PYTHON=/mnt/home/dataset/shw/Workspace/.venv-cannbench/bin/python
CANN_BENCH_DIR=/mnt/home/dataset/shw/Workspace/cann-bench-2.0.0
PTO_TILE_LIB_CODE_PATH=/home/shw/Workspace/pto-isa

# Agent CLI on the new host.
FK_AGENT_PY=python3
FK_CLAUDE_BIN=claude
FORGEKERNEL_LOCK_DIR=/mnt/home/dataset/shw/Workspace/.forgekernel-locks
HOME=/mnt/home/dataset/shw
TMPDIR=/mnt/home/dataset/shw/Workspace/.tmp
