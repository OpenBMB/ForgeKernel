# Read by forge run; machine-specific oracle paths are filled from the frozen ref tree.
[loop]
language = "pypto"
kb_arch = "ascend950"
gate_window = "device"
oracle_mode = "source"
recon_op = ""
ref_mode = "ref"
ref_name = "CANN-Bench public PyPTO SwiGlu"
ref_shape = "20 public cases"
ref_hardware = "Ascend950PR"
ref_from_goal = "off"
ref_price_op = ""
precision_contract = "off"
correctness_monitor = "off"
confirm_jobs = 1
ncu_available = false
job_env_preflight = "warn"
timeline_probe = "off"
stall_pricing = false
orch_census = false
dsl_source_dirs = ["/mnt/home/dataset/shw/Workspace/.venv-cannbench/lib/python3.12/site-packages/pypto", "/home/shw/Workspace/pto-isa"]
