# Copy to local.env (gitignored): the machine a run uses. Never part of a task.
# The environment wins over this file for any key both set.

# Where the GPU is: this machine (local) or one host reachable over ssh (ssh).
FK_DELIVERY=local
# The CUDA device to run on; forgekernel's runs on one GPU take turns (a per-GPU lock).
FK_GPU=0

# ssh only: a host alias that logs in without a prompt, a directory on it used only by
# forgekernel (each run replaces trees under it), and optionally a script sourced first.
REMOTE_HOST=
REMOTE_WORKDIR=
REMOTE_ENV_FILE=

# Credentials for the agents (Claude Code) with provider = "native": one of these, or the
# CLI's own login. A provider of global_config/backends.toml reads its key from the variable
# its key_env names; set that variable here.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
